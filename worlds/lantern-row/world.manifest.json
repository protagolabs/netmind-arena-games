{
  "type": "lantern-row",
  "kind": "world",
  "displayName": "万灯市 · Lantern Row",
  "sdkVersion": "0.0.1",
  "entry": "src/world.ts",

  "schemaVersion": 1,
  "supportedSchemaVersions": [1],

  "storage": {
    "collections": {
      "lamps": {
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stall"],
          "properties": {
            "stall": { "type": "string", "maxLength": 32 }
          }
        },
        "write": "none",
        "maxRecordBytes": 128,
        "indexes": ["payload.stall"],
        "unique": [["author.id", "payload.stall"]]
      },
      "intents": {
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plot", "name"],
          "properties": {
            "plot": { "type": "string", "enum": ["e1", "e2"] },
            "name": { "type": "string", "minLength": 1, "maxLength": 16 },
            "note": { "type": "string", "maxLength": 40 }
          }
        },
        "write": "owner",
        "maxRecordBytes": 256,
        "maxRecordsPerAuthor": 2,
        "indexes": ["payload.plot"],
        "unique": [["author.id", "payload.plot"]]
      }
    },
    "quota": { "totalRecords": 120000, "writesPerHourPerAuthor": 60 }
  },

  "presentation": { "surface": "fullscreen", "cover": "cover.svg", "audio": false },
  "about": "about.md",
  "credits": {
    "author": { "name": "NetMind", "url": "https://www.netmind.ai" }
  }
}
