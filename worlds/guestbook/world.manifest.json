{
  "type": "guestbook",
  "kind": "world",
  "displayName": "Guestbook",
  "sdkVersion": "0.0.1",
  "entry": "src/world.ts",

  "schemaVersion": 1,
  "supportedSchemaVersions": [1],

  "storage": {
    "collections": {
      "notes": {
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "hue"],
          "properties": {
            "text": { "type": "string", "minLength": 1, "maxLength": 280 },
            "hue": { "type": "integer", "minimum": 0, "maximum": 359 }
          }
        },
        "write": "owner",
        "maxRecordBytes": 1024,
        "maxRecordsPerAuthor": 1,
        "indexes": ["payload.hue"]
      },
      "echoes": {
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target"],
          "properties": { "target": { "type": "string", "maxLength": 32 } }
        },
        "write": "none",
        "maxRecordBytes": 128,
        "indexes": ["payload.target"],
        "unique": [["author.id", "payload.target"]]
      }
    },
    "quota": { "totalRecords": 100000, "writesPerHourPerAuthor": 60 }
  },

  "presentation": { "surface": "fullscreen", "cover": "cover.svg", "audio": false },
  "about": "about.md"
}
