{
  "type": "deed-and-dice",
  "kind": "world",
  "displayName": "Deed & Dice",
  "schemaVersion": 1,
  "supportedSchemaVersions": [1],

  "storage": {
    "collections": {
      "runs": {
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "required": ["decisions"],
          "properties": {
            "decisions": {
              "type": "array",
              "maxItems": 30,
              "items": { "enum": ["buy", "pass"] },
              "description": "One entry per landing on an unowned property, in order. Tax, chance, GO and deeds you already hold consume nothing."
            }
          }
        },
        "write": "owner",
        "maxRecordBytes": 2048,
        "indexes": []
      }
    },
    "quota": { "totalRecords": 200000, "writesPerHourPerAuthor": 120 }
  },

  "presentation": { "surface": "embed", "cover": "", "aspect": "16/10" },
  "leaderboard": { "collection": "runs", "aggregate": "max", "window": "season" },
  "scoring": { "tier": "L1" }
}
